{
  "name": "patent-quick-search",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "check": "npm run check:ci && npm run build",
    "check:repository": "node scripts/check-repository.mjs",
    "check:release": "node scripts/check-release.mjs",
    "audit:licenses": "node scripts/dependency-inventory.mjs",
    "notices:generate": "node scripts/generate-notices.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "tauri": "tauri",
    "check:ci": "npm run check:repository && npm run lint && npm run typecheck && npm test && npm run test:tooling"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
